forge "Payment Platform" {
  description "Architecture and delivery model for Payments"

  model {
    customer = person "Customer" {
      description "End user making payments"
    }

    payments = system "Payment Service" {
      description "Processes card and bank payments"
      tags "core" "pci"

      api = container "Payment API" {
        technology "Rust / Actix"
        description "REST + gRPC gateway"

        rest = component "REST Controller" {
          technology "Actix-web"
          description "Handles HTTP/REST requests"
        }
        grpc = component "gRPC Service" {
          technology "Tonic"
          description "Handles gRPC requests"
        }
        auth = component "Auth Middleware" {
          technology "JWT"
          description "Validates tokens and API keys"
        }
        router = component "Request Router" {
          description "Routes requests to handlers"
        }
        rest -> router "forwards to"
        grpc -> router "forwards to"
        auth -> rest "protects"
        auth -> grpc "protects"
      }

      processor = container "Payment Processor" {
        technology "Rust"
        description "Core payment processing logic"
      }

      notifier = container "Notification Service" {
        technology "Go"
        description "Sends email and SMS receipts"
      }

      db = container "Ledger DB" {
        technology "PostgreSQL 16"
        tags "database"
        data-class "pii" "financial"
      }

      cache = container "Session Cache" {
        technology "Redis"
        tags "database"
      }

      api -> processor "delegates to" "gRPC"
      api -> cache "reads sessions" "Redis protocol"
      processor -> db "reads/writes" "SQL"
      processor -> notifier "sends receipt" "async message"
    }

    customer -> payments.api "makes payments" "HTTPS"
  }

  process {
    repo = repository "payments-api" {
      url "https://github.com/acme/payments-api"
      system payments
    }

    trunk-based = strategy "Trunk-based" {
      trunk = branch "main" {
        protection "require-review" "require-ci"
      }
      feature = branch "feature/*" {
        branches-from trunk
        merges-into trunk
      }
    }

    payments-ci = pipeline "Payments CI" {
      triggers repo "push"

      build = stage "Build & Test" {
        step "cargo build --release"
        step "cargo test"
      }

      security = stage "Security Scan" {
        needs build
        step "trivy image payments-api:latest"
        gate "no-critical-vulns"
      }

      staging = stage "Deploy Staging" {
        needs security
        environment staging
        gate "integration-tests-pass"
      }

      prod = stage "Deploy Production" {
        needs staging
        environment production
        gate "manual-approval" {
          approvers "platform-team"
        }
      }
    }
  }

  deployment production "Production" {
    node aws "AWS" {
      technology "Amazon Web Services"

      node us-east-1 "us-east-1" {
        technology "AWS Region"

        node eks "EKS Cluster" {
          technology "Kubernetes 1.29"

          node api-pods "API Pods" {
            technology "3 replicas"
            instance api
          }

          node processor-pods "Processor Pods" {
            technology "3 replicas"
            instance processor
          }

          node notification-pods "Notification Pods" {
            technology "2 replicas"
            instance notifier
          }
        }

        node rds "RDS" {
          technology "Managed PostgreSQL"
          description "Primary + 2 read replicas, synchronous replication"
          instance db
        }

        node elasticache "ElastiCache" {
          technology "Managed Redis"
          description "3-node cluster with consistent hashing"
          instance cache
        }
      }
    }
  }

  tech-stack {
    category "Languages & Frameworks" {
      tech "Rust" { version "1.75"
        purpose "Payment API and Processor" }
      tech "Actix-web" { version "4"
        purpose "HTTP/REST framework" }
      tech "Tonic" { version "0.11"
        purpose "gRPC framework" }
      tech "Go" { version "1.21"
        purpose "Notification Service" }
    }
    category "Data Stores" {
      tech "PostgreSQL" { version "16"
        purpose "Ledger and transaction data" }
      tech "Redis" { version "7"
        purpose "Session cache and rate limiting" }
    }
    category "Infrastructure" {
      tech "Kubernetes" { version "1.29"
        purpose "Container orchestration" }
      tech "AWS" { purpose "Cloud platform (EKS, RDS, ElastiCache)" }
      tech "Docker" { purpose "Container images" }
      tech "Terraform" { purpose "Infrastructure as code" }
    }
    category "CI/CD & Tooling" {
      tech "GitHub Actions" { purpose "CI/CD pipelines" }
      tech "Trivy" { purpose "Container security scanning" }
      tech "Gitleaks" { purpose "Secret detection" }
      tech "Cargo" { purpose "Rust build system and package manager" }
    }
    category "Observability" {
      tech "Grafana" { purpose "Dashboards and alerting" }
      tech "Prometheus" { purpose "Metrics collection" }
      tech "CloudWatch" { purpose "Log aggregation" }
    }
  }

  data-model {
    entity "Transaction" {
      field "id" "UUID" "PK"
      field "amount" "DECIMAL(19,4)" "NOT NULL"
      field "currency" "VARCHAR(3)" "NOT NULL"
      field "status" "ENUM" "NOT NULL"
      field "customer_id" "UUID" "FK"
      field "created_at" "TIMESTAMP" "NOT NULL"
      field "updated_at" "TIMESTAMP" "NOT NULL"
      owner db
    }

    entity "Customer" {
      field "id" "UUID" "PK"
      field "email" "VARCHAR(255)" "UNIQUE"
      field "name" "VARCHAR(100)"
      field "created_at" "TIMESTAMP" "NOT NULL"
      owner db
    }

    entity "PaymentMethod" {
      field "id" "UUID" "PK"
      field "customer_id" "UUID" "FK"
      field "type" "ENUM" "NOT NULL"
      field "token" "VARCHAR(255)" "NOT NULL"
      field "last_four" "VARCHAR(4)"
      field "expiry" "DATE"
      owner db
    }

    entity "Session" {
      field "id" "UUID" "PK"
      field "customer_id" "UUID"
      field "idempotency_key" "VARCHAR(255)" "UNIQUE"
      field "ttl" "INTEGER" "seconds"
      owner cache
    }

    relationship "Customer" "Transaction" {
      label "places"
      cardinality "1:N"
    }
    relationship "Customer" "PaymentMethod" {
      label "has"
      cardinality "1:N"
    }
    relationship "PaymentMethod" "Transaction" {
      label "used in"
      cardinality "1:N"
    }
  }

  trust-boundaries {
    boundary "Public Internet" {
      level "public"
      includes customer
    }
    boundary "API Gateway (DMZ)" {
      level "dmz"
      includes payments.api
    }
    boundary "Internal Services" {
      level "internal"
      includes payments.processor
      includes payments.notifier
    }
    boundary "PCI Data Zone" {
      level "pci"
      includes payments.db
      includes payments.cache
    }
  }

  teams {
    team "Platform Team" {
      owns payments.api
      owns payments.processor
      owns payments.db
      contact "#platform-eng on Slack"
    }
    team "Notifications Team" {
      owns payments.notifier
      contact "#notifications on Slack"
    }
    team "Infrastructure Team" {
      owns payments.cache
      contact "#infra-oncall on Slack"
    }
  }

  apis {
    api payments.api {
      endpoint "POST" "/payments" {
        description "Create a new payment"
        request "{ amount, currency, customer_id, payment_method_id }"
        response "{ id, status, created_at }"
      }
      endpoint "GET" "/payments/{id}" {
        description "Get payment details"
        response "{ id, amount, currency, status, customer_id }"
      }
      endpoint "POST" "/payments/{id}/refund" {
        description "Refund a payment"
        request "{ amount, reason }"
        response "{ id, status, refund_id }"
      }
      endpoint "GET" "/payments" {
        description "List payments with filters"
        response "{ items: [...], total, page }"
      }
    }
    api payments.processor {
      endpoint "RPC" "ProcessPayment" {
        description "gRPC: process a payment authorization"
      }
      endpoint "RPC" "CapturePayment" {
        description "gRPC: capture a previously authorized payment"
      }
    }
  }

  event-flows {
    flow "payment-completed" {
      topic "payments.events.completed"
      description "Emitted after successful payment capture"
      publisher payments.processor
      subscriber payments.notifier
    }
    flow "payment-failed" {
      topic "payments.events.failed"
      description "Emitted when payment processing fails"
      publisher payments.processor
      subscriber payments.notifier
    }
    flow "receipt-sent" {
      topic "notifications.events.sent"
      description "Emitted after receipt email/SMS delivery"
      publisher payments.notifier
    }
  }

  env-config {
    env "staging" {
      PAYMENT_GATEWAY "stripe-test"
      DATABASE_URL "postgres://staging-rds:5432/payments"
      REDIS_URL "redis://staging-cache:6379"
      LOG_LEVEL "debug"
      FEATURE_3DS "true"
    }
    env "production" {
      PAYMENT_GATEWAY "stripe-live"
      DATABASE_URL "postgres://prod-rds:5432/payments"
      REDIS_URL "redis://prod-cache:6379"
      LOG_LEVEL "warn"
      FEATURE_3DS "true"
      RATE_LIMIT "10000"
    }
  }

  slos {
    slo payments.api {
      latency "< 200ms p99"
      availability "99.99%"
      error-budget "0.01% per month"
    }
    slo payments.processor {
      latency "< 500ms p99"
      availability "99.99%"
    }
    slo payments.db {
      availability "99.999%"
    }
  }

  dependencies {
    dependency "Stripe" {
      kind "payment-processor"
      criticality "critical"
      url "https://api.stripe.com"
      description "Primary payment gateway for card processing"
    }
    dependency "Adyen" {
      kind "payment-processor"
      criticality "high"
      description "Secondary payment gateway, EU fallback"
    }
    dependency "AWS SES" {
      kind "saas"
      criticality "medium"
      description "Email delivery for payment receipts"
    }
    dependency "Twilio" {
      kind "saas"
      criticality "medium"
      description "SMS delivery for payment receipts"
    }
  }

  views {
    system-context-view payments "SystemContext" {
      include *
      auto-layout lr
      title "Payment Platform — System Context"
    }

    container-view payments "Containers" {
      include *
      auto-layout tb
      title "Payment Platform — Containers"
    }

    component-view payments.api "APIComponents" {
      include *
      auto-layout tb
      title "Payment API — Components"
    }

    pipeline-view payments-ci "Pipeline" {
      include *
      auto-layout lr
      title "Payment API — CI/CD Pipeline"
    }

    deployment-view production "Deployment" {
      include *
      auto-layout tb
      title "Payment Platform — Production Deployment"
    }

    tech-stack-view "TechStack" {
      include *
      title "Payment Platform — Technology Stack"
    }

    branching-view trunk-based "Branching" {
      include *
      auto-layout tb
      title "Payment API — Branching Strategy"
    }

    data-model-view "DataModel" {
      include *
      title "Payment Platform — Data Model"
    }

    trust-boundary-view "TrustBoundaries" {
      include *
      title "Payment Platform — Trust Boundaries"
    }

    team-view "Teams" {
      include *
      title "Payment Platform — Team Ownership"
    }

    api-catalog-view "APICatalog" {
      include *
      title "Payment Platform — API Catalog"
    }

    event-flow-view "EventFlows" {
      include *
      title "Payment Platform — Event Flows"
    }

    container-view payments "PaymentFlow" {
      title "Payment Flow — Step by Step"
      auto-layout tb

      animation {
        frame "Customer initiates payment" {
          include customer
          include payments.api
          include customer -> payments.api
          notes "The customer sends a payment request via HTTPS to the Payment API."
        }

        frame "API delegates to processor" {
          include payments.processor
          include payments.api -> payments.processor
          notes "The API validates the request and delegates to the Payment Processor via gRPC."
        }

        frame "Transaction recorded" {
          include payments.db
          include payments.processor -> payments.db
          notes "The processor writes the transaction to the Ledger DB with full ACID guarantees."
        }

        frame "Receipt notification sent" {
          include payments.notifier
          include payments.processor -> payments.notifier
          notes "An async message triggers the Notification Service to send a receipt."
        }

        frame "Complete payment flow" {
          include *
          highlight payments.api -> payments.processor {
            color "#E65100"
            label "Critical path"
          }
          highlight payments.processor -> payments.db {
            color "#E65100"
          }
        }
      }
    }
  }

  docs {
    doc "Overview" "docs/overview.md"
    doc "Architecture Decisions" "docs/architecture-decisions.md"
    doc "Deployment" "docs/deployment.md"
    doc "Security" "docs/security.md"
    doc "ADR-006: Async Notifications and Caching" "docs/adr-006-async-notifications-and-caching.md"
  }
}
