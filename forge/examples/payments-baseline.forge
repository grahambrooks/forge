forge "Payment Platform" {
  description "Architecture and delivery model for Payments"

  model {
    customer = person "Customer" {
      description "End user making payments"
    }

    payments = system "Payment Service" {
      description "Processes card and bank payments"
      tags "core" "pci"

      api = container "Payment API" {
        technology "Rust / Actix"
        description "REST + gRPC gateway"
      }

      processor = container "Payment Processor" {
        technology "Rust"
        description "Core payment processing logic"
      }

      db = container "Ledger DB" {
        technology "PostgreSQL 16"
        tags "database"
      }

      api -> processor "delegates to" "gRPC"
      processor -> db "reads/writes" "SQL"
    }

    customer -> payments.api "makes payments" "HTTPS"
  }

  process {
    repo = repository "payments-api" {
      url "https://github.com/acme/payments-api"
      system payments
    }

    strategy "trunk-based" {
      trunk = branch "main" {
        protection "require-review" "require-ci"
      }
      feature = branch "feature/*" {
        branchesFrom trunk
        mergesInto trunk
      }
    }

    pipeline "payments-ci" {
      triggers repo.main on "push"

      build = stage "Build & Test" {
        step "cargo build --release"
        step "cargo test"
      }

      security = stage "Security Scan" {
        needs build
        step "trivy image payments-api:latest"
        gate "no-critical-vulns"
      }

      staging = stage "Deploy Staging" {
        needs security
        environment staging
        gate "integration-tests-pass"
      }

      prod = stage "Deploy Production" {
        needs staging
        environment production
        gate "manual-approval" {
          approvers "platform-team"
        }
      }
    }
  }

  views {
    systemContext payments "SystemContext" {
      include *
      autoLayout lr
      title "Payment Platform — System Context"
    }

    container payments "Containers" {
      include *
      autoLayout tb
      title "Payment Platform — Containers"
    }

    pipelineView "payments-ci" "Pipeline" {
      include *
      autoLayout lr
      title "Payment API — CI/CD Pipeline"
    }
  }

  techStack {
    category "Languages & Frameworks" {
      tech "Rust" { version "1.75"
        purpose "Payment API and Processor" }
      tech "Actix-web" { version "4"
        purpose "HTTP/REST framework" }
      tech "Tonic" { version "0.11"
        purpose "gRPC framework" }
    }
    category "Data Stores" {
      tech "PostgreSQL" { version "16"
        purpose "Ledger and transaction data" }
    }
    category "Infrastructure" {
      tech "Kubernetes" { version "1.29"
        purpose "Container orchestration" }
      tech "AWS" { purpose "Cloud platform" }
      tech "Docker" { purpose "Container images" }
    }
    category "CI/CD & Tooling" {
      tech "GitHub Actions" { purpose "CI/CD pipelines" }
      tech "Trivy" { purpose "Container security scanning" }
      tech "Cargo" { purpose "Rust build system and package manager" }
    }
  }

  docs {
    doc "Overview" "docs/overview.md"
    doc "Architecture Decisions" "docs/architecture-decisions.md"
    doc "Deployment" "docs/deployment.md"
    doc "Security" "docs/security.md"
  }
}
