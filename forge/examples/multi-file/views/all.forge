// View definitions — included inside the views { } block

system-context-view payments "SystemContext" {
  include *
  auto-layout lr
  title "System Context"
}

container-view payments "Containers" {
  include *
  auto-layout tb
  title "Containers"
}

pipeline-view ci "Pipeline" {
  include *
  auto-layout lr
  title "CI Pipeline"
}
