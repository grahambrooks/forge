FROM alpine:3.20
RUN apk add --no-cache file bash

COPY dist/forge-musl /usr/local/bin/forge
COPY forge/examples/payments.forge /fixtures/payments.forge
COPY tests/integration/install/run-install-tests.sh /run-install-tests.sh
RUN chmod +x /run-install-tests.sh /usr/local/bin/forge

CMD ["/run-install-tests.sh"]
