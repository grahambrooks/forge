        tags "inferred:code"
      }

      example-graceful-shutdown = container "example-graceful-shutdown" {
        description "Rust crate at examples/graceful-shutdown"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      axum-macros = container "axum-macros" {
        description "Rust crate at axum-macros"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-validator = container "example-validator" {
        description "Rust crate at examples/validator"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-routes-and-handlers-close-together = container "example-routes-and-handlers-close-together" {
        description "Rust crate at examples/routes-and-handlers-close-together"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-tls-graceful-shutdown = container "example-tls-graceful-shutdown" {
        description "Rust crate at examples/tls-graceful-shutdown"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-websockets-http2 = container "example-websockets-http2" {
        description "Rust crate at examples/websockets-http2"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-simple-router-wasm = container "example-simple-router-wasm" {
        description "Rust crate at examples/simple-router-wasm"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-jwt = container "example-jwt" {
        description "Rust crate at examples/jwt"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-multipart-form = container "example-multipart-form" {
        description "Rust crate at examples/multipart-form"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      axum-core = container "axum-core" {
        description "Rust crate at axum-core"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-testing = container "example-testing" {
        description "Rust crate at examples/testing"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-stream-to-file = container "example-stream-to-file" {
        description "Rust crate at examples/stream-to-file"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-todos = container "example-todos" {
        description "Rust crate at examples/todos"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-handle-head-request = container "example-handle-head-request" {
        description "Rust crate at examples/handle-head-request"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-error-handling = container "example-error-handling" {
        description "Rust crate at examples/error-handling"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-consume-body-in-extractor-or-middleware = container "example-consume-body-in-extractor-or-middleware" {
        description "Rust crate at examples/consume-body-in-extractor-or-middleware"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      axum-extra = container "axum-extra" {
        description "Rust crate at axum-extra"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-http-proxy = container "example-http-proxy" {
        description "Rust crate at examples/http-proxy"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-request-id = container "example-request-id" {
        description "Rust crate at examples/request-id"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      _inferred_redis = container "Redis" {
        technology "Redis"
        tags "database" "inferred:semantic"
      }

      _inferred_postgresql = container "PostgreSQL" {
        technology "PostgreSQL"
        tags "database" "inferred:semantic"
      }

      example-global-404-handler = container "example-global-404-handler" {
        description "Rust crate at examples/global-404-handler"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-hello-world = container "example-hello-world" {
        description "Rust crate at examples/hello-world"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-unix-domain-socket = container "example-unix-domain-socket" {
        description "Rust crate at examples/unix-domain-socket"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-dependency-injection = container "example-dependency-injection" {
        description "Rust crate at examples/dependency-injection"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-sse = container "example-sse" {
        description "Rust crate at examples/sse"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-diesel-postgres = container "example-diesel-postgres" {
        description "Rust crate at examples/diesel-postgres"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-reverse-proxy = container "example-reverse-proxy" {
        description "Rust crate at examples/reverse-proxy"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      examples = container "examples" {
        description "Rust crate at examples"
        technology "Rust"
        tags "inferred:code"
      }

      axum = container "axum" {
        description "Rust crate at axum"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-oauth = container "example-oauth" {
        description "Rust crate at examples/oauth"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-diesel-async-postgres = container "example-diesel-async-postgres" {
        description "Rust crate at examples/diesel-async-postgres"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-serve-with-hyper = container "example-serve-with-hyper" {
        description "Rust crate at examples/serve-with-hyper"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-form = container "example-form" {
        description "Rust crate at examples/form"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-parse-body-based-on-content-type = container "example-parse-body-based-on-content-type" {
        description "Rust crate at examples/parse-body-based-on-content-type"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-print-request-response = container "example-print-request-response" {
        description "Rust crate at examples/print-request-response"
        technology "Rust / Axum"
        tags "inferred:code"
      }
      example-tokio-redis -> _inferred_redis "reads/writes"
    }
    developer = person "Developer" {
      description "Engineer inferred from CI pipeline presence"
      tags "inferred:synth"
    }
    example-tokio-redis -> _inferred_redis "reads/writes"
    user -> example-customize-extractor-error "uses"
    developer -> ci "triggers"
  }

  process {
    ci = pipeline "CI" {
      tags "inferred:ci"
      deny-check = stage "cargo-deny check" {
        needs test-msrv
        tags "inferred:ci"
      }
      wasm32-unknown-unknown = stage "wasm32-unknown-unknown" {
        needs check
        tags "inferred:ci"
      }
      test-msrv = stage "test-msrv" {
        needs check
        tags "inferred:ci"
      }
      typos = stage "Spell Check with Typos" {
        needs dependencies-are-sorted
        tags "inferred:ci"
      }
      external-types = stage "external-types" {
        needs cargo-hack
        tags "inferred:ci"
      }
      cargo-hack = stage "cargo-hack" {
        needs check-docs
        tags "inferred:ci"
      }
      check-docs = stage "check-docs" {
        needs check
        tags "inferred:ci"
      }
      test-nightly = stage "test-nightly" {
        needs check
        tags "inferred:ci"
      }
      dependencies-are-sorted = stage "dependencies-are-sorted" {
        needs wasm32-unknown-unknown
        tags "inferred:ci"
      }
      check = stage "check" {
        tags "inferred:ci"
      }
      test-versions = stage "test-versions" {
        needs check
        tags "inferred:ci"
      }
      armv5te-unknown-linux-musleabi = stage "armv5te-unknown-linux-musleabi" {
        needs check
        tags "inferred:ci"
      }
    }
  }

  views {
    system-context-view project-system "SystemContext" {
      include *
      auto-layout lr
      title "System Context"
    }
    container-view project-system "Containers" {
      include *
      auto-layout tb
      title "Containers"
    }
    pipeline-view ci "Pipeline" {
      include *
      auto-layout lr
      title "CI/CD Pipeline"
    }
    branching-view trunk "Branching" {
      include *
      auto-layout tb
      title "Branching Strategy"
    }
    tech-stack-view "TechStack" {
      include *
      auto-layout tb
      title "Technology Stack"
    }
    team-view "Teams" {
      include *
      auto-layout tb
      title "Team Ownership"
    }
    api-catalog-view "APICatalog" {
      include *
      auto-layout tb
      title "API Catalog"
    }
  }

  tech-stack {
    category "MongoDB" {
      tech "MongoDB" {
        purpose "language"
      }
    }
    category "PostgreSQL" {
      tech "PostgreSQL" {
        purpose "language"
      }
    }
    category "Redis" {
      tech "Redis" {
        purpose "language"
      }
    }
    category "Rust" {
      tech "Rust" {
        purpose "language"
      }
      tech "Axum" {
        purpose "framework"
      }
    }
  }
}
