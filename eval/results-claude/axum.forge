forge "project" {

  model {
    user = person "User" {
      description "End user inferred from a web-facing container"
      tags "inferred:synth"
    }
    project-system = system "project" {
      description "Inferred system wrapper for project"
      tags "inferred:synth"

      example-customize-extractor-error = container "example-customize-extractor-error" {
        description "Rust crate at examples/customize-extractor-error"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-customize-path-rejection = container "example-customize-path-rejection" {
        description "Rust crate at examples/customize-path-rejection"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      _inferred_mongodb = container "MongoDB" {
        technology "MongoDB"
        tags "database" "inferred:semantic"
      }

      example-tracing-aka-logging = container "example-tracing-aka-logging" {
        description "Rust crate at examples/tracing-aka-logging"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-websockets = container "example-websockets" {
        description "Rust crate at examples/websockets"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-compression = container "example-compression" {
        description "Rust crate at examples/compression"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-static-file-server = container "example-static-file-server" {
        description "Rust crate at examples/static-file-server"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-templates = container "example-templates" {
        description "Rust crate at examples/templates"
