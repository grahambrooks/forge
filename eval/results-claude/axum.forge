        tags "inferred:code"
      }

      example-low-level-native-tls = container "example-low-level-native-tls" {
        description "Rust crate at examples/low-level-native-tls"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-sqlx-postgres = container "example-sqlx-postgres" {
        description "Rust crate at examples/sqlx-postgres"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-cors = container "example-cors" {
        description "Rust crate at examples/cors"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-key-value-store = container "example-key-value-store" {
        description "Rust crate at examples/key-value-store"
