        tags "inferred:code"
      }

      example-prometheus-metrics = container "example-prometheus-metrics" {
        description "Rust crate at examples/prometheus-metrics"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-tokio-redis = container "example-tokio-redis" {
        description "Rust crate at examples/tokio-redis"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-versioning = container "example-versioning" {
        description "Rust crate at examples/versioning"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-mongodb = container "example-mongodb" {
        description "Rust crate at examples/mongodb"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-reqwest-response = container "example-reqwest-response" {
        description "Rust crate at examples/reqwest-response"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-tokio-postgres = container "example-tokio-postgres" {
        description "Rust crate at examples/tokio-postgres"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-low-level-rustls = container "example-low-level-rustls" {
        description "Rust crate at examples/low-level-rustls"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-readme = container "example-readme" {
        description "Rust crate at examples/readme"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-tls-rustls = container "example-tls-rustls" {
        description "Rust crate at examples/tls-rustls"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-testing-websockets = container "example-testing-websockets" {
        description "Rust crate at examples/testing-websockets"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-anyhow-error-response = container "example-anyhow-error-response" {
        description "Rust crate at examples/anyhow-error-response"
        technology "Rust / Axum"
        tags "inferred:code"
      }

      example-chat = container "example-chat" {
        description "Rust crate at examples/chat"
